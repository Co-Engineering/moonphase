# ---------------------------------------------------------------------------
# Moonphase configuration
#
# Copy to .env and fill in. Every value below has a dev-friendly default that
# matches what `supabase start` prints locally, except MOONPHASE_SECRET_KEY,
# which you must generate.
# ---------------------------------------------------------------------------

# Encrypts SSH private keys and harness credentials at rest (Fernet).
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MOONPHASE_SECRET_KEY=

# Postgres. Locally this is what `supabase start` exposes.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54722/postgres

# Supabase / GoTrue. `supabase start` prints these; for a real self-host they
# come from your Supabase docker-compose .env.
SUPABASE_URL=http://127.0.0.1:54721
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# API
MOONPHASE_API_HOST=0.0.0.0
MOONPHASE_API_PORT=8471
MOONPHASE_CORS_ORIGINS=http://localhost:8472,app://.

# Container image projects run in. Built by infra/images/claude.
MOONPHASE_RUNTIME_IMAGE=moonphase/runtime-claude:latest

# SSH behaviour
MOONPHASE_SSH_CONNECT_TIMEOUT=15
MOONPHASE_SSH_KEEPALIVE_INTERVAL=30
# Trust and pin a server's host key the first time we see it. Set to false to
# require the fingerprint to be supplied up front.
MOONPHASE_SSH_TRUST_ON_FIRST_USE=true

# --- previews ---------------------------------------------------------------
# Interface the per-port preview listeners bind to. Loopback suits a backend on
# the same machine as your browser; use 0.0.0.0 when the backend is remote and
# you want previews reachable from your phone.
MOONPHASE_PREVIEW_BIND=127.0.0.1
# Host clients should dial to reach those listeners.
MOONPHASE_PREVIEW_HOST=127.0.0.1

# --- github -----------------------------------------------------------------
# Client id of a GitHub OAuth app, enabling one-click device-flow sign-in.
# No client secret is needed. Leave blank to connect with a personal access
# token instead.
MOONPHASE_GITHUB_CLIENT_ID=

# Frontend (Vite reads these; they are public by design).
#
# Only needed for `pnpm dev`, where Vite serves the app on its own port. A
# built frontend is served by the API itself and discovers all of this from
# GET /api/config, which is what lets a phone connect by typing one address.
VITE_SUPABASE_URL=http://127.0.0.1:54721
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8471

# --- notifications ------------------------------------------------------------
# How often to check whether each running agent is still working, in seconds.
# 0 disables the monitor, and with it notifications.
MOONPHASE_MONITOR_INTERVAL=20
# Web push keypair. Generate with:
#   apps/api/.venv/bin/python scripts/gen_vapid.py >> .env
MOONPHASE_VAPID_PUBLIC_KEY=
MOONPHASE_VAPID_PRIVATE_KEY=
MOONPHASE_VAPID_SUBJECT=mailto:you@example.com
