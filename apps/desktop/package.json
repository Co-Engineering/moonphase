{
  "name": "@moonphase/desktop",
  "version": "0.9.1",
  "private": true,
  "description": "Moonphase desktop app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle": "node scripts/collect-web.mjs",
    "package": "pnpm run build && pnpm run bundle && electron-builder",
    "package:dir": "pnpm run build && pnpm run bundle && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.18.1",
    "electron": "^33.0.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "dk.coec.moonphase",
    "productName": "Moonphase",
    "copyright": "Moonphase",
    "directories": {
      "output": "release",
      "buildResources": "packaging"
    },
    "files": [
      "dist/**/*",
      "web/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "synopsis": "Coding agents on servers you own",
      "desktop": {
        "entry": {
          "StartupWMClass": "Moonphase"
        }
      },
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "executableName": "moonphase"
  },
  "desktopName": "moonphase.desktop",
  "author": {
    "name": "Moonphase",
    "email": "oliversvane@users.noreply.github.com"
  },
  "homepage": "https://github.com/oliversvane/moonphase",
  "dependencies": {
    "ws": "^8.21.3"
  }
}
