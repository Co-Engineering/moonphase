<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Only what V8 itself needs (electronjs.org/docs/latest/tutorial/code-signing)
	to not crash on launch under Hardened Runtime. This app has no native Node
	modules — the only runtime dependency is the pure-JS `ws` package — and no
	Squirrel.Mac auto-update (it only opens the release page in a browser), so
	the dylib-injection allowances the same doc mentions for that case are not
	load-bearing here. Add them back only alongside a specific native
	dependency that actually needs them, naming it.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- The renderer talks to a user-configured Moonphase server over HTTP(S)
	     and WebSocket, and the preview relay dials out too. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
