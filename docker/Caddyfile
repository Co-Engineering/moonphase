# One address for the whole product, with a certificate it obtains itself.
#
# The client uses supabase-js for sign-in, which calls `${SUPABASE_URL}/auth/v1/…`.
# GoTrue serves those routes at its root, so something has to strip the prefix.
# A full Supabase deployment uses Kong for this; a few lines of Caddy do the
# same job without a second configuration language.
#
# Routing everything through one origin is also what makes the phone client
# work: same origin means no CORS to configure, and the service worker lands at
# the root scope that push requires.
{
	admin off
	log {
		level ERROR
	}

	# Certificates are obtained on demand, for whatever hostname arrives, after
	# asking the API whether that name is the configured one. That is what lets
	# someone type their domain into a setup screen and have HTTPS work: no file
	# to edit, no container to restart, and nothing about the address baked into
	# the image or the compose file.
	#
	# The ask endpoint refuses anything unconfigured, so pointing a DNS record
	# at this machine does not let a stranger mint certificates against it.
	on_demand_tls {
		ask http://api:8471/api/setup/tls-allowed
	}
}

(moonphase) {
	# GoTrue's own signup switch is an environment variable, so turning it off
	# would mean restarting a container. Asking per request keeps the decision
	# in the database, where the setup screen can change it.
	handle /auth/v1/signup {
		forward_auth api:8471 {
			uri /api/setup/signup-allowed
		}
		rewrite * /signup
		reverse_proxy auth:9999
	}

	# handle_path strips the matched prefix, which is the rewrite GoTrue needs:
	# /auth/v1/token -> /token
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}

	handle {
		reverse_proxy api:8471 {
			# The terminal and the feed are WebSockets. Caddy upgrades them
			# without configuration, but buffering would make a live terminal
			# arrive in batches, so flushing is forced.
			flush_interval -1
		}
	}
}

# Plain HTTP, always. On a laptop this is the whole thing; in front of a domain
# Caddy redirects it to HTTPS by itself.
:8471 {
	import moonphase
}

# HTTPS for any hostname the API vouches for.
:443 {
	tls {
		on_demand
	}
	import moonphase
}
