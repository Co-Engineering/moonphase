{
  "name": "moonphase",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted control plane for remote AI coding sessions",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:web": "pnpm --filter @moonphase/web dev",
    "dev:desktop": "pnpm --filter @moonphase/desktop dev",
    "build": "pnpm --filter @moonphase/web build && pnpm --filter @moonphase/desktop build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
